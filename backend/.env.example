# Flask Application Secret Key
SECRET_KEY=your-secret-key-here

# JWT Authentication Secret Key
JWT_SECRET_KEY=your-jwt-secret-key-here

# Groq AI API Key (obtain from https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Mail Configuration (Gmail SMTP or other provider)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_DEFAULT_SENDER=your-email@gmail.com

# Optional Database URL (PostgreSQL / MySQL) - defaults to local SQLite if omitted
# DATABASE_URL=postgresql://username:password@localhost:5432/smartrevisedb
